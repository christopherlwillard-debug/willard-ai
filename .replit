modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "media-viewer-e2e"

[[workflows.workflow]]
name = "backend-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run audit:backend"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "organize-helpers-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && node --experimental-strip-types --test src/__tests__/organize-helpers.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "optimize-cycle-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && node --experimental-strip-types --test src/__tests__/optimize-cycle.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-dashboard-scan"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --experimental-strip-types --test e2e/dashboard-after-scan.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "cleanup-queue-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --experimental-strip-types --test artifacts/api-server/src/__tests__/cleanup-queue.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "cleanup-execute-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --experimental-strip-types --test e2e/cleanup-execute.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "media-viewer-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test e2e/media-viewer.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[workflows.workflow]]
name = "routed-browser-checks"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/willard-ai"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:routed"

